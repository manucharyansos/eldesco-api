APP_NAME="ELDESCO API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Yerevan
APP_LOCALE=hy
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug
CACHE_STORE=file
SESSION_DRIVER=file
FILESYSTEM_DISK=local

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eldesco_db
DB_USERNAME=eldesco_user
DB_PASSWORD=
DB_SSLMODE=prefer

ADMIN_EMAIL=admin@eldesco.am
ADMIN_PASSWORD=change-this-before-seeding

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
