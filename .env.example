APP_NAME="ELDESCO API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Yerevan
APP_LOCALE=hy
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eldesco
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ELDESCO_ADMIN_EMAIL=admin@eldesco.am
ELDESCO_ADMIN_PASSWORD=change-me-before-production

# --- Production (https://api.eldesco.am serves the API, https://eldesco.am is the website) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.eldesco.am
# CORS_ALLOWED_ORIGINS=https://eldesco.am,https://www.eldesco.am
# SANCTUM_STATEFUL_DOMAINS=eldesco.am,www.eldesco.am
# ELDESCO_ADMIN_EMAIL=admin@eldesco.am
# ELDESCO_ADMIN_PASSWORD=<strong unique password>
