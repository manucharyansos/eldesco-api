# Copy to .env on the server:  cp .env.production.example .env  &&  php artisan key:generate
APP_NAME="ELDESCO API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.eldesco.am
APP_TIMEZONE=Asia/Yerevan
APP_LOCALE=hy
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eldesco
DB_USERNAME=eldesco
DB_PASSWORD=CHANGE_ME

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
FILESYSTEM_DISK=public

# The website that is allowed to call this API from the browser (admin panel).
# List every hostname visitors can use, without trailing slashes.
CORS_ALLOWED_ORIGINS=https://eldesco.am,https://www.eldesco.am
SANCTUM_STATEFUL_DOMAINS=eldesco.am,www.eldesco.am

# First admin account (created by the seeder; in production the seeder refuses the default password).
ELDESCO_ADMIN_EMAIL=admin@eldesco.am
ELDESCO_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
